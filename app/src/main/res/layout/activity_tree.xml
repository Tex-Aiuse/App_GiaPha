<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <include
        android:id="@+id/appBar"
        layout="@layout/view_app_bar" />

    <!-- Dải "Chế độ chỉ xem": chỉ hiện khi AdminApp xem cây từ GD-24 -->
    <LinearLayout
        android:id="@+id/bandReadOnly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/green_band"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_visibility" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/be_vietnam_pro_medium"
            android:text="Chế độ chỉ xem"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Dải "Đang lọc N đời · Bỏ lọc": chỉ hiện khi đang lọc số đời -->
    <LinearLayout
        android:id="@+id/bandFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/peach_light"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvFilterInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical|end"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:fontFamily="@font/be_vietnam_pro_semibold"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvFilterClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:minHeight="40dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="16dp"
            android:text="Bỏ lọc"
            android:textColor="@color/brown_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.example.my_app_giapha.tree.TreeViewport
            android:id="@+id/viewport"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_screen" />

        <com.example.my_app_giapha.ui.common.StateView
            android:id="@+id/stateView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Lọc số đời: chỉ sáng khi đã chọn một thẻ; lọc quanh thẻ đó. Nằm ngoài menu, không có nút zoom +/− -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="16dp"
            android:alpha="0.4"
            android:contentDescription="Lọc số đời"
            android:visibility="gone"
            app:backgroundTint="@color/brown_primary"
            app:srcCompat="@drawable/ic_filter"
            app:tint="@color/white" />

        <!-- Chỉ Admin và Quản lý thấy; ẩn mặc định, bật theo vai trò sau khi tải -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:fontFamily="@font/be_vietnam_pro_semibold"
            android:text="Thêm thành viên"
            android:textColor="@color/white"
            android:visibility="gone"
            app:backgroundTint="@color/brown_primary"
            app:icon="@drawable/ic_add"
            app:iconTint="@color/white" />
    </FrameLayout>
</LinearLayout>