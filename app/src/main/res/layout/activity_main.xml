<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <include
        android:id="@+id/appBar"
        layout="@layout/view_app_bar" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="Nội dung màn hình"
        android:textColor="@color/text_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:orientation="vertical">

        <TextView android:id="@+id/b1" style="@style/Widget.GiaPha.Badge"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/b2" style="@style/Widget.GiaPha.Badge"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
        <TextView android:id="@+id/b3" style="@style/Widget.GiaPha.Badge"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
        <TextView android:id="@+id/b4" style="@style/Widget.GiaPha.Badge"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
        <TextView android:id="@+id/b5" style="@style/Widget.GiaPha.Badge"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
        <TextView android:id="@+id/b6" style="@style/Widget.GiaPha.Badge"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</LinearLayout>