<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <include
        android:id="@+id/appBar"
        layout="@layout/view_app_bar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ScrollView
                android:id="@+id/scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_circle_peach">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_warning" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/be_vietnam_pro_bold"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp" />

                    <!-- Thẻ tóm tắt dữ liệu sẽ bị xóa -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_card_danger_left"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/be_vietnam_pro_semibold"
                            android:text="DỮ LIỆU SẼ BỊ XÓA"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <LinearLayout
                            style="@style/Widget.GiaPha.XoaDong"
                            android:layout_marginTop="12dp">

                            <View style="@style/Widget.GiaPha.XoaCham" />

                            <TextView
                                android:id="@+id/tvSoThanhVien"
                                style="@style/Widget.GiaPha.XoaChu" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/Widget.GiaPha.XoaDong"
                            android:layout_marginTop="8dp">

                            <View style="@style/Widget.GiaPha.XoaCham" />

                            <TextView
                                android:id="@+id/tvSoO"
                                style="@style/Widget.GiaPha.XoaChu" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/Widget.GiaPha.XoaDong"
                            android:layout_marginTop="8dp">

                            <View style="@style/Widget.GiaPha.XoaCham" />

                            <TextView
                                style="@style/Widget.GiaPha.XoaChu"
                                android:text="Toàn bộ tiểu sử, bình luận, thành tựu, ảnh đại diện liên quan sẽ bị xóa" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:background="@color/border_default" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:drawablePadding="8dp"
                            android:fontFamily="@font/be_vietnam_pro_bold"
                            android:gravity="center_vertical"
                            android:text="Hành động này không thể hoàn tác."
                            android:textColor="@color/danger"
                            android:textSize="14sp"
                            app:drawableStartCompat="@drawable/ic_warning" />
                    </LinearLayout>

                    <!-- Báo lỗi (chỉ hiện sau khi xóa thất bại) -->
                    <LinearLayout
                        android:id="@+id/bannerError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_banner_error"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_warning" />

                        <TextView
                            android:id="@+id/tvError"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:text="Không thể xóa không gian. Đã xảy ra lỗi giữa chừng, dữ liệu chưa bị thay đổi. Vui lòng thử lại."
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Widget.GiaPha.FieldLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/be_vietnam_pro_bold"
                            android:text="Lý do xóa"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:fontFamily="@font/be_vietnam_pro_bold"
                            android:text="*"
                            android:textColor="@color/danger"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etReason"
                        style="@style/Widget.GiaPha.Input"
                        android:layout_width="match_parent"
                        android:layout_height="112dp"
                        android:layout_marginTop="8dp"
                        android:gravity="top|start"
                        android:hint="Nhập lý do xóa không gian này..."
                        android:importantForAutofill="no"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLength="200"
                        android:maxLines="5"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp" />

                    <TextView
                        android:id="@+id/tvCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:gravity="end"
                        android:text="0/200"
                        android:textColor="@color/text_hint"
                        android:textSize="12sp" />
                </LinearLayout>
            </ScrollView>

            <!-- Khu nút ghim đáy -->
            <LinearLayout
                android:id="@+id/actionBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_default" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirm"
                    style="@style/Widget.GiaPha.Button.Danger"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:text="Xác nhận xóa"
                    app:backgroundTint="@color/button_danger_bg"
                    app:icon="@drawable/ic_trash_white"
                    app:iconGravity="textStart"
                    app:iconTint="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancel"
                    style="@style/Widget.GiaPha.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_margin="16dp"
                    android:layout_marginTop="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Hủy"
                    app:backgroundTint="@color/peach_light"
                    app:cornerRadius="16dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Lớp phủ toàn màn (dưới thanh tiêu đề): đang xóa / đã xóa. Chặn mọi chạm phía sau. -->
        <FrameLayout
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/scrim_cream"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_card"
                android:elevation="8dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp">

                    <ProgressBar
                        android:id="@+id/progress"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/brown_primary" />

                    <FrameLayout
                        android:id="@+id/tick"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle_green_mid"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_check_white" />
                    </FrameLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvOverlayTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvOverlayDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>